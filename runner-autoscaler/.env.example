# Vault AppRole — fetched from local-secrets/2026-04-09-tsavo-runner-autoscaler-approle.txt
VAULT_ADDR=https://vault.wopr.bot
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# GitHub
GITHUB_ORG=wopr-network

# Optional: additional repo-scoped pools. Comma-separated owner/repo entries.
# Webhooks from these repos get repo-scoped runners (instead of org-scoped).
# GITHUB_REPOS=TSavo/nefariousplan

# Vault field on shared/github that holds the PAT used for repo-scoped
# registrations. Defaults to ops_pat (a broad PAT that works on both org
# and personal repos). Org-scoped runners always use runner_registration_pat.
# GITHUB_REPO_PAT_FIELD=ops_pat

# Listener
LISTENER_PORT=3000
LISTENER_BIND=0.0.0.0

# Runner pool behavior
RUNNER_IMAGE=github-runners-runner
RUNNER_LABELS=self-hosted,Linux,X64,vault
# Count ceiling only (no MIN — warm pool is demand-driven). Arithmetic for 10:
#   10 × ~3.4GB ≈ 34GB on a 62GB box → ~28GB headroom for recensus/floors/sshd.
#   25 × 3.4GB ≈ 85GB = 137% of physical → thrash (2026-08-02: load 138, MemFree 1GB).
# Heavy work is single-process or k=8 — never needed 25 seats.
MAX_RUNNERS=10
# Memory law (not a guess): refuse spawn if MemAvailable - RUNNER_ESTIMATED_MB
# would fall below the floor. Same shape as measurement load gate.
RUNNER_MEMORY_FLOOR_MB=28672
RUNNER_ESTIMATED_MB=3482
IDLE_TIMEOUT_MINUTES=10
REAPER_INTERVAL_SECONDS=60

# Docker network the runner containers join (created externally, e.g. by the github-runners compose project)
RUNNER_NETWORK=github-runners_runner-network
RUNNER_VAULT_GITHUB_PAT_FILE=/home/tsavo/.config/vault/secrets/github-pat
